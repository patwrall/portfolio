{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-04-14",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  // Training log entries, keyed by Access identity. Only reachable from
  // private.patrickwrall.com — see src/pages/api/training-log.ts.
  "kv_namespaces": [
    {
      "binding": "TRAINING_LOG",
      "id": "f6c827b5df71490a9e6e29eaf6f280aa"
    }
  ]
}
